# Release 签名配置模板。
#
# 用法:复制为同目录下的 keystore.properties(该文件已被 .gitignore,绝不入库),填入真实值。
# 缺少此文件时 release 构建回退为未签名(assembleRelease 仍可产出 unsigned APK,便于 CI 验证编译)。
#
# keystore 本身也不要放进仓库。生成命令示例:
#   keytool -genkeypair -v -keystore vibeterm-release.jks -alias vibeterm \
#           -keyalg RSA -keysize 4096 -validity 10000

storeFile=D:/dev-tools/vibeterm-release.jks
storePassword=在此填入 keystore 密码
keyAlias=vibeterm
keyPassword=在此填入 key 密码
